{
  "name": "bloglist-backend",
  "version": "1.0.0",
  "description": "Full Stack Open Part 4 - Blog List backend (Express + MongoDB + tests + auth)",
  "main": "index.js",
  "type": "commonjs",
  "scripts": {
    "start": "cross-env NODE_ENV=production node index.js",
    "dev": "cross-env NODE_ENV=development node --watch index.js",
    "start:test": "cross-env NODE_ENV=test node --watch index.js",
    "test": "cross-env NODE_ENV=test node --test --test-concurrency=1",
    "lint": "eslint .",
    "format": "prettier --write .",
    "build:ui": "rm -rf dist && cd ../frontend && npm run build && cp -r dist ../backend"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "eslint": "^9.15.0",
    "globals": "^15.12.0",
    "prettier": "^3.9.6",
    "supertest": "^7.0.0"
  }
}
